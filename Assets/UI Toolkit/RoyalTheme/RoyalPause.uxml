<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Style src="RoyalTheme.uss"/>
    <ui:VisualElement name="overlay" class="royal-overlay royal-hidden" style="display: none;">
        <ui:VisualElement class="royal-panel">
            <ui:VisualElement class="royal-inner">
                <ui:Label text="Paused" class="royal-title"/>
                <ui:Label text="— Kingdom Sentinels —" name="subtitle" class="royal-subtitle"/>
                <ui:VisualElement class="royal-divider"/>
                <ui:Button text="Resume" name="resume" class="royal-button royal-button--primary"/>
                <ui:Button text="Restart" name="restart" class="royal-button"/>
                <ui:Button text="Main menu" name="menu" class="royal-button"/>
            </ui:VisualElement>
            <ui:Button text="×" name="exit" class="royal-close"/>
        </ui:VisualElement>
    </ui:VisualElement>
    <!-- Tutorial paper (TutorialPaper.cs). Kept after the pause overlay so it is drawn on top of it. -->
    <ui:VisualElement name="TutorialPaper" class="royal-overlay royal-hidden paper-overlay" style="display: none;">
        <ui:VisualElement class="royal-panel paper-panel">
            <ui:VisualElement class="royal-inner paper-inner">
                <ui:Label text="Tutorial 1 of 3" name="PaperStep" class="royal-subtitle paper-step"/>
                <ui:Label text="Defend the Castle!" name="PaperTitle" class="royal-title paper-title"/>
                <ui:VisualElement class="royal-divider paper-divider"/>
                <ui:VisualElement class="paper-body">
                    <ui:VisualElement name="PaperIcon" class="paper-icon"/>
                    <ui:VisualElement name="PaperLines" class="paper-lines"/>
                </ui:VisualElement>
                <ui:Button text="To battle!" name="PaperClose" class="royal-button royal-button--primary paper-button"/>
                <ui:Label text="or press Enter" class="paper-hint"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
