/* In-game HUD skin (wave bar, speech bubble, enemy meter, tower cards, gold). Applied by RoyalHudSkin. */

#GameFlowHUD {
    background-color: rgb(239, 226, 192);
    border-width: 5px;
    border-color: rgb(107, 74, 36);
    border-radius: 8px;
}
#GameFlowLabel {
    -unity-font-definition: url("Fonts/Cinzel.ttf");
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: rgb(74, 50, 22);
}
#GameFlowStartNow {
    -unity-font-definition: url("Fonts/Cinzel.ttf");
    letter-spacing: 2px;
    background-color: rgb(122, 59, 34);
    color: rgb(245, 234, 208);
    border-width: 3px;
    border-color: rgb(90, 42, 22);
    border-radius: 6px;
}
#GameFlowStartNow:hover { background-color: rgb(142, 70, 40); }

.money-hud .money-label { -unity-font-definition: url("Fonts/Cinzel.ttf"); }

#WaveHUD > Label {
    -unity-font-definition: url("Fonts/Cinzel.ttf");
    color: rgb(245, 234, 208);
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: rgb(60, 30, 0);
    letter-spacing: 2px;
}
#WaveMeter {
    background-color: rgba(40, 26, 10, 0.7);
    border-color: rgb(107, 74, 36);
}
#WaveMeter #Bar { background-color: rgb(150, 62, 34); }

.tower-card .card-name, .tower-card .card-cost { -unity-font-definition: url("Fonts/Cinzel.ttf"); font-size: 44px; letter-spacing: 0; }
.tower-card .stat-name, .tower-card .stat-text, .tower-card .card-note { -unity-font-definition: url("Fonts/CrimsonText-Regular.ttf"); }

#Speech #Tutorial {
    background-color: rgb(239, 226, 192);
    border-width: 3px;
    border-color: rgb(107, 74, 36);
    border-radius: 6px;
}
#Speech #Title {
    -unity-font-definition: url("Fonts/Cinzel.ttf");
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: rgb(122, 59, 34);
    font-size: 20px;
}
#Speech #Desc {
    -unity-font-definition: url("Fonts/CrimsonText-Regular.ttf");
    color: rgb(74, 50, 22);
    font-size: 20px;
}
#Speech #exit {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: rgb(138, 106, 58);
    font-size: 26px;
}
#Speech #exit:hover { color: rgb(74, 50, 22); }

/* Floating damage numbers above towers and the castle (DamageNumbers.cs). */
.royal-damage { -unity-font-definition: url("Fonts/Cinzel.ttf"); }

/* One-time "cannot build here" popup (UIResponder.ShowPlacementWarning). Never blocks clicks. */
.warning-layer {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 480px;   /* tower bar is 450px high (TowerCards.uss): sit just above it */
    align-items: center;
}
.placement-warning {
    max-width: 1500px;
    padding: 28px 48px 32px 48px;
    align-items: center;
    background-color: rgb(239, 226, 192);
    border-width: 8px;
    border-color: rgb(107, 74, 36);
    border-radius: 18px;
    opacity: 0;
    translate: 0 30px;
    transition-property: opacity, translate;
    transition-duration: 0.25s;
}
.placement-warning.shown {
    opacity: 1;
    translate: 0 0;
}
.warning-title {
    -unity-font-definition: url("Fonts/Cinzel.ttf");
    -unity-font-style: bold;
    font-size: 56px;
    letter-spacing: 2px;
    color: rgb(122, 59, 34);
    margin: 0 0 10px 0;
    padding: 0;
    white-space: nowrap;
}
.warning-text {
    -unity-font-definition: url("Fonts/CrimsonText-Regular.ttf");
    font-size: 46px;
    color: rgb(74, 50, 22);
    margin: 0;
    padding: 0;
    white-space: normal;
    -unity-text-align: middle-center;
}

/* Tutorial: "Start now" blinks once the first tower is built (GameFlow + UIPulse). */
#GameFlowStartNow.pulse {
    transition-property: border-color, scale, background-color;
    transition-duration: 0.4s;
    transition-timing-function: ease-in-out;
}
#GameFlowStartNow.pulse-on {
    border-color: rgb(255, 208, 0);
    background-color: rgb(170, 84, 44);
    scale: 1.1 1.1;
}

/* Gold HUD feedback (UIResponder): a short bump when coins arrive, red + shake when the player cannot pay. */
.money-hud {
    transition-property: scale;
    transition-duration: 0.12s;
}
.money-hud.gain { scale: 1.15 1.15; }
.money-hud.deny .money-label { color: rgb(255, 70, 50); }

/* Floating "+N" gold with a coin where an enemy dies; it flies to the gold HUD (GoldPopups.cs). */
.gold-popup { flex-direction: row; align-items: center; }
.gold-popup-label {
    -unity-font-definition: url("Fonts/Cinzel.ttf");
    -unity-font-style: bold;
    font-size: 64px;
    color: rgb(255, 228, 92);
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: rgb(60, 30, 0);
    margin: 0 8px 0 0;
    padding: 0;
}
.gold-popup-coin {
    width: 72px;
    height: 72px;
    background-image: url("/Assets/UI Toolkit/HUDIcons/Icon_Coin.png");
    -unity-background-scale-mode: scale-to-fit;
}

/* Wave route on the right (GameFlow): a dotted march route, one dot per wave, the boss medallion on top.
   Round dots and ink colours on purpose: nothing here may look like a button. */
#WaveTrack {
    position: absolute;
    top: 40px;
    right: 40px;
    width: 340px;
    padding: 24px 28px 30px 28px;
    align-items: stretch;
    background-color: rgb(239, 226, 192);
    border-width: 5px;
    border-color: rgb(107, 74, 36);
    border-radius: 8px;
}
.wave-track-title {
    -unity-font-definition: url("Fonts/Cinzel.ttf");
    -unity-font-style: bold;
    font-size: 44px;
    letter-spacing: 2px;
    color: rgb(74, 50, 22);
    -unity-text-align: middle-center;
    margin: 0;
    padding: 0;
}
.wave-track-count {
    -unity-font-definition: url("Fonts/Cinzel.ttf");
    font-size: 34px;
    color: rgb(138, 106, 58);
    -unity-text-align: middle-center;
    margin: 0 0 14px 0;
    padding: 0;
}
.wave-track-column { flex-direction: column-reverse; }

.wave-stop { flex-direction: row; align-items: center; height: 64px; }
.wave-stop.boss { height: 90px; }
.wave-dot-holder { width: 70px; height: 100%; align-items: center; justify-content: center; }
.wave-dot {
    width: 30px;
    height: 30px;
    border-radius: 15px;
    border-width: 4px;
    border-color: rgba(107, 74, 36, 0.5);
    background-color: rgba(0, 0, 0, 0);
    transition-property: background-color, border-color, scale;
    transition-duration: 0.35s;
}
.wave-stop-label {
    -unity-font-definition: url("Fonts/Cinzel.ttf");
    font-size: 32px;
    color: rgba(107, 74, 36, 0.55);
    margin: 0 0 0 12px;
    padding: 0;
    transition-property: color;
    transition-duration: 0.35s;
}
/* started: inked in */
.wave-stop.filled .wave-dot { background-color: rgb(74, 50, 22); border-color: rgb(74, 50, 22); }
.wave-stop.filled .wave-stop-label { color: rgb(74, 50, 22); }
/* countdown to this wave: gold ring */
.wave-stop.next .wave-dot { border-color: rgb(212, 160, 40); border-width: 5px; scale: 1.15 1.15; }
.wave-stop.next .wave-stop-label { color: rgb(160, 112, 20); }
/* being fought: glowing gold dot */
.wave-stop.current .wave-dot { background-color: rgb(232, 182, 52); border-color: rgb(255, 238, 170); scale: 1.35 1.35; }
.wave-stop.current .wave-stop-label { color: rgb(160, 112, 20); -unity-font-style: bold; }
/* boss medallion */
.wave-stop.boss .wave-dot { width: 62px; height: 62px; border-radius: 31px; border-width: 6px; border-color: rgba(110, 24, 18, 0.6); }
.wave-stop.boss .wave-stop-label { font-size: 40px; -unity-font-style: bold; color: rgba(110, 24, 18, 0.6); }
.wave-stop.boss.next .wave-dot { border-color: rgb(212, 160, 40); }
.wave-stop.boss.filled .wave-dot { background-color: rgb(110, 24, 18); border-color: rgb(110, 24, 18); }
.wave-stop.boss.current .wave-dot { background-color: rgb(110, 24, 18); border-color: rgb(232, 182, 52); scale: 1.15 1.15; }
.wave-stop.boss.filled .wave-stop-label, .wave-stop.boss.current .wave-stop-label { color: rgb(110, 24, 18); }

/* dotted path between two stops */
.wave-link { width: 70px; height: 34px; align-items: center; justify-content: space-around; }
.wave-link-dot { width: 6px; height: 6px; border-radius: 3px; background-color: rgba(107, 74, 36, 0.35); }
.wave-link.filled .wave-link-dot { background-color: rgb(74, 50, 22); }
