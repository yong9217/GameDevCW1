/* In-game HUD skin (wave bar, speech bubble, enemy meter, tower cards, gold). Applied by RoyalHudSkin. */

#GameFlowHUD {
    background-color: rgb(239, 226, 192);
    border-width: 5px;
    border-color: rgb(107, 74, 36);
    border-radius: 8px;
}
#GameFlowLabel {
    -unity-font-definition: url("Fonts/Cinzel.ttf");
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: rgb(74, 50, 22);
}
#GameFlowStartNow {
    -unity-font-definition: url("Fonts/Cinzel.ttf");
    letter-spacing: 2px;
    background-color: rgb(122, 59, 34);
    color: rgb(245, 234, 208);
    border-width: 3px;
    border-color: rgb(90, 42, 22);
    border-radius: 6px;
}
#GameFlowStartNow:hover { background-color: rgb(142, 70, 40); }

.money-hud .money-label { -unity-font-definition: url("Fonts/Cinzel.ttf"); }

#WaveHUD > Label {
    -unity-font-definition: url("Fonts/Cinzel.ttf");
    color: rgb(245, 234, 208);
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: rgb(60, 30, 0);
    letter-spacing: 2px;
}
#WaveMeter {
    background-color: rgba(40, 26, 10, 0.7);
    border-color: rgb(107, 74, 36);
}
#WaveMeter #Bar { background-color: rgb(150, 62, 34); }

.tower-card .card-name, .tower-card .card-cost { -unity-font-definition: url("Fonts/Cinzel.ttf"); font-size: 44px; letter-spacing: 0; }
.tower-card .stat-name, .tower-card .stat-text, .tower-card .card-note { -unity-font-definition: url("Fonts/CrimsonText-Regular.ttf"); }

#Speech #Tutorial {
    background-color: rgb(239, 226, 192);
    border-width: 3px;
    border-color: rgb(107, 74, 36);
    border-radius: 6px;
}
#Speech #Title {
    -unity-font-definition: url("Fonts/Cinzel.ttf");
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: rgb(122, 59, 34);
    font-size: 20px;
}
#Speech #Desc {
    -unity-font-definition: url("Fonts/CrimsonText-Regular.ttf");
    color: rgb(74, 50, 22);
    font-size: 20px;
}
#Speech #exit {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: rgb(138, 106, 58);
    font-size: 26px;
}
#Speech #exit:hover { color: rgb(74, 50, 22); }

/* Floating damage numbers above towers and the castle (DamageNumbers.cs). */
.royal-damage { -unity-font-definition: url("Fonts/Cinzel.ttf"); }

/* One-time "cannot build here" popup (UIResponder.ShowPlacementWarning). Never blocks clicks. */
.warning-layer {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 480px;   /* tower bar is 450px high (TowerCards.uss): sit just above it */
    align-items: center;
}
.placement-warning {
    max-width: 1500px;
    padding: 28px 48px 32px 48px;
    align-items: center;
    background-color: rgb(239, 226, 192);
    border-width: 8px;
    border-color: rgb(107, 74, 36);
    border-radius: 18px;
    opacity: 0;
    translate: 0 30px;
    transition-property: opacity, translate;
    transition-duration: 0.25s;
}
.placement-warning.shown {
    opacity: 1;
    translate: 0 0;
}
.warning-title {
    -unity-font-definition: url("Fonts/Cinzel.ttf");
    -unity-font-style: bold;
    font-size: 56px;
    letter-spacing: 2px;
    color: rgb(122, 59, 34);
    margin: 0 0 10px 0;
    padding: 0;
    white-space: nowrap;
}
.warning-text {
    -unity-font-definition: url("Fonts/CrimsonText-Regular.ttf");
    font-size: 46px;
    color: rgb(74, 50, 22);
    margin: 0;
    padding: 0;
    white-space: normal;
    -unity-text-align: middle-center;
}

/* Tutorial: "Start now" blinks once the first tower is built (GameFlow + UIPulse). */
#GameFlowStartNow.pulse {
    transition-property: border-color, scale, background-color;
    transition-duration: 0.4s;
    transition-timing-function: ease-in-out;
}
#GameFlowStartNow.pulse-on {
    border-color: rgb(255, 208, 0);
    background-color: rgb(170, 84, 44);
    scale: 1.1 1.1;
}

/* Gold HUD feedback (UIResponder): a short bump when coins arrive, red + shake when the player cannot pay. */
.money-hud {
    transition-property: scale;
    transition-duration: 0.12s;
}
.money-hud.gain { scale: 1.15 1.15; }
.money-hud.deny .money-label { color: rgb(255, 70, 50); }

/* Floating "+N" gold with a coin where an enemy dies; it flies to the gold HUD (GoldPopups.cs). */
.gold-popup { flex-direction: row; align-items: center; }
.gold-popup-label {
    -unity-font-definition: url("Fonts/Cinzel.ttf");
    -unity-font-style: bold;
    font-size: 64px;
    color: rgb(255, 228, 92);
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: rgb(60, 30, 0);
    margin: 0 8px 0 0;
    padding: 0;
}
.gold-popup-coin {
    width: 72px;
    height: 72px;
    background-image: url("/Assets/UI Toolkit/HUDIcons/Icon_Coin.png");
    -unity-background-scale-mode: scale-to-fit;
}

/* Wave track on the right (GameFlow): one segment per wave, filled when that wave starts; the boss on top. */
#WaveTrack {
    position: absolute;
    top: 40px;
    right: 40px;
    width: 250px;
    padding: 22px 26px 26px 26px;
    align-items: stretch;
    background-color: rgb(239, 226, 192);
    border-width: 5px;
    border-color: rgb(107, 74, 36);
    border-radius: 8px;
}
.wave-track-title {
    -unity-font-definition: url("Fonts/Cinzel.ttf");
    -unity-font-style: bold;
    font-size: 44px;
    letter-spacing: 2px;
    color: rgb(74, 50, 22);
    -unity-text-align: middle-center;
    margin: 0;
    padding: 0;
}
.wave-track-count {
    -unity-font-definition: url("Fonts/Cinzel.ttf");
    font-size: 34px;
    color: rgb(138, 106, 58);
    -unity-text-align: middle-center;
    margin: 0 0 14px 0;
    padding: 0;
}
.wave-track-column { flex-direction: column-reverse; }
.wave-seg {
    height: 74px;
    margin: 6px 0 6px 0;
    justify-content: center;
    background-color: rgba(107, 74, 36, 0.12);
    border-width: 4px;
    border-color: rgb(168, 136, 90);
    border-radius: 8px;
    transition-property: background-color, border-color, scale;
    transition-duration: 0.35s;
}
.wave-seg-label {
    -unity-font-definition: url("Fonts/Cinzel.ttf");
    -unity-font-style: bold;
    font-size: 34px;
    color: rgb(168, 136, 90);
    -unity-text-align: middle-center;
    margin: 0;
    padding: 0;
    transition-property: color;
    transition-duration: 0.35s;
}
.wave-seg.filled { background-color: rgb(150, 62, 34); border-color: rgb(90, 42, 22); }
.wave-seg.filled .wave-seg-label { color: rgb(245, 234, 208); }
.wave-seg.current { scale: 1.06 1.06; border-color: rgb(255, 208, 0); }
.wave-seg.boss { height: 90px; border-color: rgb(196, 150, 40); }
.wave-seg.boss .wave-seg-label { font-size: 38px; }
.wave-seg.boss.filled { background-color: rgb(110, 24, 18); border-color: rgb(255, 208, 0); }
