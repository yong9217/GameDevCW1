<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Style src="RoyalTheme.uss"/>
    <ui:VisualElement class="royal-menu-root" picking-mode="Ignore">
        <ui:VisualElement class="royal-panel royal-menu-panel">
            <ui:VisualElement class="royal-inner">
                <ui:Label text="Kingdom" class="royal-title royal-menu-title"/>
                <ui:Label text="Sentinels" class="royal-title royal-menu-title"/>
                <ui:Label text="— Defend the castle —" class="royal-subtitle"/>
                <ui:VisualElement class="royal-divider"/>
                <ui:Button text="Campaign" name="start" class="royal-button royal-button--primary"/>
                <ui:Button text="Infinite Mode" name="infinite" class="royal-button royal-button--primary"/>
                <ui:Button text="Leaderboard" name="leaderboard" class="royal-button"/>
                <ui:Button text="Glossary" name="bestiary" class="royal-button"/>
                <ui:Button text="Credits" name="credits" class="royal-button"/>
                <ui:Button text="Exit" name="exit" class="royal-button"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
    <!-- Infinite mode top 5 of this computer (filled by MainMenu.cs from InfiniteLeaderboard). -->
    <ui:VisualElement name="leaderboardOverlay" class="royal-overlay" style="display: none;">
        <ui:VisualElement class="royal-panel">
            <ui:VisualElement class="royal-inner">
                <ui:Label text="Leaderboard" class="royal-title"/>
                <ui:Label text="— Infinite Mode —" class="royal-subtitle"/>
                <ui:VisualElement class="royal-divider"/>
                <ui:VisualElement class="lb-section lb-board">
                    <ui:Label text="TOP 5 - LONGEST DEFENCE" class="royal-credits-heading lb-heading"/>
                    <ui:VisualElement name="leaderboardRows"/>
                </ui:VisualElement>
                <ui:Label text="Times are saved on this computer only." class="royal-text royal-text--small"/>
            </ui:VisualElement>
            <ui:Button text="×" name="leaderboardClose" class="royal-close"/>
        </ui:VisualElement>
    </ui:VisualElement>
    <!-- Shown when the locked Infinite Mode button is clicked. -->
    <ui:VisualElement name="lockedOverlay" class="royal-overlay" style="display: none;">
        <ui:VisualElement class="royal-panel">
            <ui:VisualElement class="royal-inner">
                <ui:Label text="Locked" class="royal-title"/>
                <ui:VisualElement class="royal-divider"/>
                <ui:Label text="Win the Campaign once to unlock &lt;b&gt;Infinite Mode&lt;/b&gt;." class="royal-text" style="margin-bottom: 24px;"/>
                <ui:Button text="OK" name="lockedOk" class="royal-button royal-button--primary"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
    <!-- Shown once, on the first visit to the menu after the Campaign has been won. -->
    <ui:VisualElement name="unlockOverlay" class="royal-overlay" style="display: none;">
        <ui:VisualElement class="royal-panel" style="width: 920px;">
            <ui:VisualElement class="royal-inner">
                <ui:Label text="Congratulations!" class="royal-title"/>
                <ui:Label text="— You have defended the kingdom —" class="royal-subtitle"/>
                <ui:VisualElement class="royal-divider"/>
                <ui:Label text="You unlocked &lt;b&gt;INFINITE MODE&lt;/b&gt;: hold the castle for as long as you can and set a record on the leaderboard." class="royal-text" style="margin-bottom: 24px;"/>
                <ui:Button text="OK" name="unlockOk" class="royal-button royal-button--primary"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
