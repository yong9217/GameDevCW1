/* Kingdom Sentinels - parchment UI theme. Colours, fonts and buttons for every menu live here. */

.royal-overlay {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(24, 16, 6, 0.6);
    opacity: 1;
    transition-property: opacity;
    transition-duration: 0.2s;
    transition-timing-function: ease-out;
}
.royal-overlay.royal-hidden { opacity: 0; }

.royal-panel {
    width: 600px;
    padding: 10px;
    background-color: rgb(239, 226, 192);
    border-width: 4px;
    border-color: rgb(107, 74, 36);
    border-radius: 6px;
    scale: 1 1;
    transition-property: scale;
    transition-duration: 0.2s;
    transition-timing-function: ease-out-cubic;
}
.royal-overlay.royal-hidden .royal-panel { scale: 0.95 0.95; }
.royal-panel--wide { width: 680px; }

.royal-inner {
    padding: 40px 48px 36px 48px;
    border-width: 1px;
    border-color: rgba(138, 106, 58, 0.6);
    border-radius: 3px;
    align-items: stretch;
}

.royal-title {
    -unity-font-definition: url("Fonts/Cinzel.ttf");
    font-size: 64px;
    -unity-font-style: bold;
    letter-spacing: 4px;
    color: rgb(74, 50, 22);
    -unity-text-align: middle-center;
    margin: 0;
    padding: 0;
}
.royal-title--defeat { color: rgb(122, 42, 26); }

.royal-subtitle {
    -unity-font-definition: url("Fonts/Cinzel.ttf");
    font-size: 22px;
    letter-spacing: 2px;
    color: rgb(138, 106, 58);
    -unity-text-align: middle-center;
    margin: 4px 0 0 0;
    padding: 0;
}

.royal-divider {
    height: 1px;
    margin: 26px 40px 28px 40px;
    background-color: rgb(168, 136, 90);
}

.royal-text {
    -unity-font-definition: url("Fonts/CrimsonText-Regular.ttf");
    font-size: 28px;
    color: rgb(74, 50, 22);
    -unity-text-align: middle-center;
    white-space: normal;
    margin: 0 0 8px 0;
    padding: 0;
}

.royal-credits { margin: 8px 0 26px 0; align-items: center; }
.royal-credits-heading {
    -unity-font-definition: url("Fonts/Cinzel.ttf");
    font-size: 18px;
    letter-spacing: 3px;
    color: rgb(138, 106, 58);
    margin: 0 0 8px 0;
    padding: 0;
}
.royal-credits-name {
    -unity-font-definition: url("Fonts/CrimsonText-Bold.ttf");
    font-size: 30px;
    color: rgb(74, 50, 22);
    margin: 0;
    padding: 0;
}

.royal-button {
    -unity-font-definition: url("Fonts/Cinzel.ttf");
    font-size: 26px;
    letter-spacing: 2px;
    height: 62px;
    margin: 0 0 14px 0;
    padding: 0;
    border-width: 2px;
    border-radius: 4px;
    border-color: rgb(168, 136, 90);
    background-color: rgba(0, 0, 0, 0);
    color: rgb(74, 50, 22);
    -unity-text-align: middle-center;
    transition-property: background-color, scale;
    transition-duration: 0.12s;
}
.royal-button:hover { background-color: rgba(138, 106, 58, 0.16); }
.royal-button:active { scale: 0.98 0.98; }

.royal-button--primary {
    background-color: rgb(122, 59, 34);
    border-color: rgb(90, 42, 22);
    color: rgb(245, 234, 208);
}
.royal-button--primary:hover { background-color: rgb(142, 70, 40); }

.royal-link {
    -unity-font-definition: url("Fonts/Cinzel.ttf");
    font-size: 20px;
    letter-spacing: 1px;
    color: rgb(138, 106, 58);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    margin: 4px 0 0 0;
    -unity-text-align: middle-center;
}
.royal-link:hover { color: rgb(74, 50, 22); }

.royal-close {
    position: absolute;
    top: 14px;
    right: 18px;
    width: 40px;
    height: 40px;
    padding: 0;
    margin: 0;
    font-size: 30px;
    color: rgb(138, 106, 58);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    -unity-text-align: middle-center;
}
.royal-close:hover { color: rgb(74, 50, 22); }

/* ---------- Main menu ---------- */
.royal-menu-root {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    justify-content: center;
    padding-left: 140px;
}
.royal-menu-panel { width: 620px; }
.royal-menu-title { font-size: 72px; letter-spacing: 6px; }

/* ---------- Credits ---------- */
.royal-text--small { font-size: 22px; color: rgb(110, 82, 44); margin: 0; }

/* ---------- Glossary ---------- */
.royal-panel--glossary { width: 1720px; }
.royal-divider--tight { margin: 18px 200px 14px 200px; }
.royal-section {
    -unity-font-definition: url("Fonts/Cinzel.ttf");
    font-size: 24px;
    letter-spacing: 4px;
    color: rgb(138, 106, 58);
    -unity-text-align: middle-center;
    margin: 10px 0 12px 0;
    padding: 0;
}
.royal-entry-row { flex-direction: row; justify-content: space-between; margin-bottom: 10px; }
.royal-entry {
    width: 388px;
    height: 250px;
    flex-direction: row;
    padding: 14px;
    background-color: rgb(92, 62, 30);
    border-width: 3px;
    border-color: rgb(60, 38, 16);
    border-radius: 4px;
}
.royal-entry-view {
    width: 136px;
    height: 216px;
    flex-shrink: 0;
    background-size: cover;
    border-width: 3px;
    border-color: rgb(200, 170, 110);
    border-radius: 3px;
    background-color: rgb(40, 26, 10);
}
.royal-entry-info { flex-grow: 1; flex-shrink: 1; padding: 6px 4px 0 18px; }
.royal-entry-title {
    -unity-font-definition: url("Fonts/Cinzel.ttf");
    -unity-font-style: bold;
    font-size: 28px;
    color: rgb(245, 234, 208);
    white-space: normal;
    margin: 0 0 10px 0;
    padding: 0;
}
.royal-entry-desc {
    -unity-font-definition: url("Fonts/CrimsonText-Regular.ttf");
    font-size: 24px;
    color: rgb(230, 214, 178);
    white-space: normal;
    margin: 0;
    padding: 0;
}

/* ---------- Tutorial paper (TutorialPaper.cs) ----------
   A large parchment sheet that pauses the game until the player closes it. */
.paper-overlay { background-color: rgba(24, 16, 6, 0.72); }
.paper-panel {
    width: 1080px;
    padding: 12px;
    border-width: 6px;
    border-radius: 10px;
    translate: 0 0;
    transition-property: scale, translate;
    transition-duration: 0.25s;
}
.royal-overlay.royal-hidden .paper-panel { scale: 0.9 0.9; translate: 0 40px; }
.paper-inner { padding: 30px 56px 26px 56px; }
.paper-step { font-size: 22px; letter-spacing: 4px; margin: 0 0 6px 0; }
.paper-title { font-size: 56px; white-space: normal; }
.paper-divider { margin: 20px 80px 24px 80px; }
.paper-body { flex-direction: row; align-items: flex-start; margin: 0 0 26px 0; }
.paper-icon {
    width: 190px;
    height: 190px;
    flex-shrink: 0;
    margin: 4px 36px 0 0;
    -unity-background-scale-mode: scale-to-fit;
    background-color: rgb(92, 62, 30);
    border-width: 4px;
    border-color: rgb(60, 38, 16);
    border-radius: 8px;
}
.paper-icon--none { display: none; }
.paper-icon--arrow { background-image: url("/Assets/UI Toolkit/TowerIcons/Icon_Arrow.png"); }
.paper-icon--cannon { background-image: url("/Assets/UI Toolkit/TowerIcons/Icon_Cannon.png"); }
.paper-icon--magic { background-image: url("/Assets/UI Toolkit/TowerIcons/Icon_Magic.png"); }
.paper-lines { flex-grow: 1; flex-shrink: 1; }
.paper-line-row { flex-direction: row; align-items: flex-start; margin: 0 0 14px 0; }
.paper-bullet {
    width: 11px;
    height: 11px;
    flex-shrink: 0;
    margin: 16px 18px 0 2px;
    rotate: 45deg;
    background-color: rgb(122, 59, 34);
}
.paper-line {
    -unity-font-definition: url("Fonts/CrimsonText-Regular.ttf");
    font-size: 30px;
    color: rgb(74, 50, 22);
    white-space: normal;
    flex-shrink: 1;
    margin: 0;
    padding: 0;
}
.paper-button { width: 380px; height: 70px; align-self: center; font-size: 30px; margin: 0 0 8px 0; }
.paper-hint {
    -unity-font-definition: url("Fonts/CrimsonText-Regular.ttf");
    font-size: 20px;
    color: rgb(138, 106, 58);
    -unity-text-align: middle-center;
    margin: 0;
    padding: 0;
}

/* ---------- Infinite mode result: name entry + local top 5 (EndScreenUI) ---------- */
.lb-section { margin: 4px 0 18px 0; }
.lb-entry { align-items: stretch; margin: 0 0 14px 0; }
.lb-prompt { margin: 0 0 10px 0; }
.lb-name { margin: 0 40px 14px 40px; }
.lb-name > #unity-text-input {
    -unity-font-definition: url("Fonts/CrimsonText-Bold.ttf");
    font-size: 30px;
    height: 54px;
    padding: 0 14px 0 14px;
    color: rgb(74, 50, 22);
    background-color: rgb(250, 242, 220);
    border-width: 2px;
    border-color: rgb(168, 136, 90);
    border-radius: 4px;
    -unity-text-align: middle-center;
}
.lb-entry-buttons { flex-direction: row; justify-content: center; }
.lb-button { width: 230px; margin: 0 8px 0 8px; }
.lb-board { align-items: stretch; }
.lb-heading { -unity-text-align: middle-center; margin: 6px 0 10px 0; }
.lb-row {
    flex-direction: row;
    align-items: center;
    height: 42px;
    padding: 0 18px 0 18px;
    margin: 0 30px 4px 30px;
    border-radius: 4px;
}
.lb-row--new { background-color: rgba(214, 160, 40, 0.35); }
.lb-rank, .lb-player, .lb-time, .lb-empty {
    -unity-font-definition: url("Fonts/CrimsonText-Regular.ttf");
    font-size: 26px;
    color: rgb(74, 50, 22);
    margin: 0;
    padding: 0;
}
.lb-rank { width: 50px; -unity-font-definition: url("Fonts/Cinzel.ttf"); }
.lb-player { flex-grow: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.lb-time { width: 120px; -unity-text-align: middle-right; -unity-font-definition: url("Fonts/Cinzel.ttf"); }
.lb-empty { -unity-text-align: middle-center; color: rgb(138, 106, 58); }
