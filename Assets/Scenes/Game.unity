--- !u!114 &746458700
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 746458699}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 80829da4c7bb7eb43982372773252680, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::GameFlow
  normalEnemy: {fileID: 198898714420655828, guid: 7aa2dae7b4f950f41b99efdd9d1bed80, type: 3}
  fastEnemy: {fileID: 3928838081421445988, guid: 4b70ee6c1f3202e40accb0b216f83f62, type: 3}
  heavyEnemy: {fileID: 1528338231459593670, guid: 2c9e3de54c868514abc92d87b8fc1816, type: 3}
  bossEnemy: {fileID: 7018033594880367772, guid: c81a0d50425fdf244b4958fdddc2701f, type: 3}
  castle: {fileID: 1695025997}
  gameEnd: {fileID: 1626476505}
  mouse: {fileID: 1479937794}
  hud: {fileID: 226410542}
  speech: {fileID: 1024906174}
  spawnDistance: 30
  spawnJitter: 2
  firstCountdown: 20
  countdownBetweenWaves: 15
  messageSeconds: 8
  bossEntranceInIntro: 5
  victoryMessage: Victory! The castle is safe!
  firstTowerMessage: Well done! Press Start now to call the enemies, or wait for the timer.
  firstKillMessage: Each defeated enemy gives you gold. Spend it on more towers!
  castleHitMessage: The castle is hit! If its health reaches 0, you lose.
  infinite: 0
  waves:
  - title: Tutorial 1/3
    arcDegrees: 30
    relativeToPrevWave: 0
    attackAngleDegrees: {x: 0, y: 360}
    prepMessage: Pick the blinking Arrow Tower card, then click on the ground near the castle.
    startMessage: Here they come! Your towers shoot by themselves.
    groups:
    - enemy: 0
      count: 4
      interval: 3
      startDelay: 0
    paperStep: Tutorial 1 of 3
    paperTitle: Defend the Castle!
    paperIcon: 1
    paperText: 'Enemies are marching on your castle. If its health drops to <b>0</b>, you lose.

      Survive all <b>{waves}</b> waves to win. The first 3 waves teach you how to play.

      To build, click a tower card at the bottom, then click on empty ground. <b>Right-click</b> cancels.

      Towers cost gold. Your gold is shown at the top left.

      Use <b>W A S D</b> to move the camera and look around the castle.

      Start with an <b>Arrow Tower</b>: it is cheap and fires fast at normal soldiers.'
    highlightCard: 0
  - title: Tutorial 2/3
    arcDegrees: 45
    relativeToPrevWave: 1
    attackAngleDegrees: {x: -45, y: 45}
    prepMessage: Build a Cannon Tower before the Heavies arrive!
    startMessage: Heavies are slow but tough. Let the cannons do the work!
    groups:
    - enemy: 2
      count: 2
      interval: 8
      startDelay: 0
    - enemy: 0
      count: 6
      interval: 3
      startDelay: 2
    paperStep: Tutorial 2 of 3
    paperTitle: Heavy Soldiers
    paperIcon: 2
    paperText: '<b>Heavy</b> soldiers are slow, but tough enough to shrug off arrows.

      The <b>Cannon Tower</b> fires slowly, but every shot hits very hard.

      Build one where the Heavies will walk. Tougher enemies also give more gold.'
    highlightCard: 1
  - title: Tutorial 3/3
    arcDegrees: 60
    relativeToPrevWave: 1
    attackAngleDegrees: {x: -60, y: 60}
    prepMessage: Build a Magic Tower to slow the fast raiders!
    startMessage: Here they come, fast and all together!
    groups:
    - enemy: 1
      count: 8
      interval: 0.6
      startDelay: 0
    paperStep: Tutorial 3 of 3
    paperTitle: Fast Raiders
    paperIcon: 3
    paperText: '<b>Fast</b> raiders rush in as a pack. Each one is weak, but they are hard to stop one by one.

      The <b>Magic Tower</b>''s lightning jumps between enemies standing close together: it can hit up to <b>3</b> at once.

      Every enemy it hits is also <b>slowed down</b>, giving your other towers more time to shoot.

      This is the last tutorial wave. After it, enemies come from more directions, so mix all three towers.'
    highlightCard: 2
  - title: Wave 1/3
    arcDegrees: 90
    relativeToPrevWave: 0
    attackAngleDegrees: {x: 0, y: 360}
    prepMessage: Tutorial complete! Now enemies attack from wider directions.
    startMessage: 
    groups:
    - enemy: 0
      count: 5
      interval: 2
      startDelay: 0
    - enemy: 1
      count: 10
      interval: 0.5
      startDelay: 4
    paperStep: 
    paperTitle: 
    paperIcon: 0
    paperText: 
    highlightCard: -1
  - title: Wave 2/3
    arcDegrees: 120
    relativeToPrevWave: 0
    attackAngleDegrees: {x: 0, y: 360}
    prepMessage: 
    startMessage: 
    groups:
    - enemy: 2
      count: 5
      interval: 3
      startDelay: 0
    - enemy: 0
      count: 8
      interval: 2
      startDelay: 3
    paperStep: 
    paperTitle: 
    paperIcon: 0
    paperText: 
    highlightCard: -1
  - title: Wave 3/3
    arcDegrees: 360
    relativeToPrevWave: 0
    attackAngleDegrees: {x: 0, y: 360}
    prepMessage: They are surrounding the castle. Watch every side!
    startMessage: 
    groups:
    - enemy: 2
      count: 4
      interval: 5
      startDelay: 0
    - enemy: 0
      count: 10
      interval: 2
      startDelay: 2
    - enemy: 1
      count: 12
      interval: 0.5
      startDelay: 10
    paperStep: 
    paperTitle: 
    paperIcon: 0
    paperText: 
    highlightCard: -1
  - title: Boss Wave
    arcDegrees: 360
    relativeToPrevWave: 0
    attackAngleDegrees: {x: 0, y: 360}
    prepMessage: Their leader is coming! Defeat the boss to save the castle!
    startMessage: Their soldiers come first, and the leader is right behind them!
    groups:
    - enemy: 0
      count: 8
      interval: 2.5
      startDelay: 0
    - enemy: 2
      count: 5
      interval: 1
      startDelay: 3
    - enemy: 1
      count: 9
      interval: 0.6
      startDelay: 4
    - enemy: 3
      count: 1
      interval: 1
      startDelay: 15.5
    paperStep: 
    paperTitle: 
    paperIcon: 0
    paperText: 
    highlightCard: -1
