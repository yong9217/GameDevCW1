<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="backgroundMask" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0.369); align-content: center; align-self: auto; justify-content: center;">
        <ui:VisualElement template="Pane" name="Pane" style="justify-content: space-evenly; align-self: center; align-items: auto; align-content: center; position: relative; top: 0; left: 0;">
            <ui:VisualElement name="Background" style="flex-grow: 1; background-color: rgb(224, 172, 79); width: 693px; height: 413px; align-self: center; justify-content: flex-start; align-content: auto; flex-direction: column; flex-basis: auto; background-position-y: center; background-size: 100% 1%; aspect-ratio: auto; position: relative; top: 0; left: 0; border-top-width: 5px; border-right-width: 5px; border-bottom-width: 5px; border-left-width: 5px; border-top-left-radius: 30px; border-top-right-radius: 30px; border-bottom-right-radius: 30px; border-bottom-left-radius: 30px; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0);">
                <ui:VisualElement name="Content" style="flex-grow: 1; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-top: 10px; margin-right: 70px; margin-bottom: 10px; margin-left: 30px; justify-content: space-around; align-content: stretch; align-items: center; align-self: center; flex-direction: row; flex-wrap: wrap; width: auto; height: auto; background-size: 100% 90%; -unity-background-scale-mode: stretch-to-fill; aspect-ratio: auto;">
                    <ui:Label text="Made by:&#10;Yong You Shen&#10;Xia Jin Qing" style="font-size: 75px; -unity-text-align: upper-center;"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Button text="X" name="exit" style="position: absolute; top: 49px; left: 600px; height: 44px; width: 48px; font-size: 45px; background-color: rgb(255, 0, 0); color: rgb(255, 255, 255);"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
