<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Template name="backgroundMask" src="project://database/Assets/GameDevCW1/UI%20Toolkit/UI%20XML/backgroundMask.uxml?fileID=9197481963319205126&amp;guid=2703692a653cec7448086c105c4c45ae&amp;type=3#backgroundMask"/>
    <ui:Instance template="backgroundMask" name="background" style="position: relative; height: 1080px; transition-property: translate; transition-duration: 0.5s; transition-timing-function: ease-in-bounce; translate: 0 100%;"/>
    <ui:VisualElement name="buttons" style="flex-grow: 1; position: absolute; height: 488px; width: 366px; top: 322px; left: 758px; justify-content: space-evenly; translate: 0 200%; transition-property: translate; transition-duration: 0.5s; transition-delay: 0.15s; transition-timing-function: ease-in-bounce;">
        <ui:Label text="The Castle is lost! Retreat!" style="font-size: 75px; -unity-text-align: upper-center; color: rgb(255, 128, 128); -unity-text-outline-width: 1px; -unity-text-outline-color: rgb(255, 0, 0);"/>
        <ui:Button text="Try Again" name="play" style="font-size: 50px; border-top-width: 5px; border-right-width: 5px; border-bottom-width: 5px; border-left-width: 5px; border-top-left-radius: 30px; border-top-right-radius: 30px; border-bottom-right-radius: 30px; border-bottom-left-radius: 30px; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); background-color: rgb(62, 197, 32);"/>
        <ui:Button text="Main Menu" name="return" style="font-size: 50px; background-color: rgb(218, 208, 0); border-top-width: 5px; border-right-width: 5px; border-bottom-width: 5px; border-left-width: 5px; border-top-left-radius: 30px; border-top-right-radius: 30px; border-bottom-right-radius: 30px; border-bottom-left-radius: 30px; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0);"/>
    </ui:VisualElement>
</ui:UXML>
