<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Template name="backgroundMask" src="project://database/Assets/GameDevCW1/UI%20Toolkit/UI%20XML/backgroundMask.uxml?fileID=9197481963319205126&amp;guid=2703692a653cec7448086c105c4c45ae&amp;type=3#backgroundMask"/>
    <ui:Instance template="backgroundMask" style="height: 1080px; transition-property: translate; translate: 0 100%; transition-timing-function: ease-in-bounce; transition-duration: 1.2s;"/>
    <ui:VisualElement template="Pane" style="position: relative; translate: 0 0%; transform-origin: center; transition-timing-function: ease-in-bounce; transition-delay: 0.5s;">
        <ui:VisualElement name="Background" style="flex-grow: 1; background-color: rgb(224, 172, 79); width: 798px; height: 903px; align-self: center; justify-content: flex-start; align-content: auto; flex-direction: column; flex-basis: auto; background-position-y: center; background-size: 100% 1%; aspect-ratio: auto; position: absolute; top: 82px; left: 557px; border-top-width: 5px; border-right-width: 5px; border-bottom-width: 5px; border-left-width: 5px; border-top-left-radius: 30px; border-top-right-radius: 30px; border-bottom-right-radius: 30px; border-bottom-left-radius: 30px; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0);">
            <ui:VisualElement name="Content" style="flex-grow: 1; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-top: 10px; margin-right: 70px; margin-bottom: 10px; margin-left: 30px; justify-content: flex-start; align-content: stretch; align-items: flex-start; align-self: center; flex-direction: column; flex-wrap: wrap; width: auto; height: auto; background-size: 100% 90%; -unity-background-scale-mode: stretch-to-fill; aspect-ratio: auto;">
                <ui:Label text="Paused!" style="font-size: 75px;"/>
                <ui:VisualElement name="Buttons" style="flex-grow: 1; position: absolute; top: 276px; left: -19px; height: 537px; width: 359px; justify-content: space-around;">
                    <ui:Button text="Resume" name="resume" style="font-size: 60px; border-top-width: 5px; border-right-width: 5px; border-bottom-width: 5px; border-left-width: 5px; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); border-top-left-radius: 30px; border-top-right-radius: 30px; border-bottom-right-radius: 30px; border-bottom-left-radius: 30px; background-color: rgb(255, 237, 157);"/>
                    <ui:Button text="How to Play" name="tutorial" style="font-size: 60px; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); border-top-width: 5px; border-right-width: 5px; border-bottom-width: 5px; border-left-width: 5px; border-top-left-radius: 30px; border-top-right-radius: 30px; border-bottom-right-radius: 30px; border-bottom-left-radius: 30px; background-color: rgb(2, 182, 46);"/>
                    <ui:Button text="Glossary" name="glossary" style="font-size: 60px; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); border-top-left-radius: 30px; border-top-right-radius: 30px; border-bottom-right-radius: 30px; border-bottom-left-radius: 30px; border-top-width: 5px; border-right-width: 5px; border-bottom-width: 5px; border-left-width: 5px; background-color: rgb(0, 157, 255);"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement template="exitButton">
            <ui:Button text="X" name="exit" style="position: absolute; top: 131px; left: 1264px; height: 44px; width: 48px; font-size: 45px; background-color: rgb(255, 0, 0); color: rgb(255, 255, 255);"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
