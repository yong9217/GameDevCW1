<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement template="TutorialTemplate" name="" style="visibility: visible; display: flex;">
        <ui:VisualElement name="Tutorial" style="flex-grow: 1; align-self: auto; justify-content: center; align-items: auto; align-content: auto; position: relative; height: 120px; width: 360px; top: 0; left: 0; background-color: rgb(255, 194, 73); border-left-color: rgb(166, 90, 0); border-right-color: rgb(166, 90, 0); border-top-color: rgb(166, 90, 0); border-bottom-color: rgb(166, 90, 0); border-top-width: 5px; border-right-width: 5px; border-bottom-width: 5px; border-left-width: 5px; border-top-left-radius: 30px; border-top-right-radius: 30px; border-bottom-right-radius: 30px; border-bottom-left-radius: 30px; padding-top: 20px; padding-right: 20px; padding-bottom: 20px; padding-left: 20px; flex-basis: initial; visibility: visible;">
            <ui:Label text="Royal Scout" name="Title" style="align-self: center; align-items: center; font-size: 24px;"/>
            <ui:Label text="Oh no! We are under attack!" name="Desc" style="align-self: stretch; align-items: stretch; justify-content: center; align-content: flex-start; font-size: 18px; -unity-text-align: upper-center;"/>
        </ui:VisualElement>
