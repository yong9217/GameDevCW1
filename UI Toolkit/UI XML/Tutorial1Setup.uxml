<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement template="TutorialTemplate" name="Speech" style="visibility: visible; display: flex; transition-duration: 0.4s; transition-property: scale; transition-timing-function: ease-out-bounce;">
        <ui:VisualElement name="Tutorial" style="flex-grow: 1; align-self: auto; justify-content: center; align-items: auto; align-content: auto; position: relative; height: 120px; width: 360px; top: 0; left: 0; background-color: rgb(255, 194, 73); border-left-color: rgb(166, 90, 0); border-right-color: rgb(166, 90, 0); border-top-color: rgb(166, 90, 0); border-bottom-color: rgb(166, 90, 0); border-top-width: 5px; border-right-width: 5px; border-bottom-width: 5px; border-left-width: 5px; border-top-left-radius: 30px; border-top-right-radius: 30px; border-bottom-right-radius: 30px; border-bottom-left-radius: 30px; padding-top: 20px; padding-right: 20px; padding-bottom: 20px; padding-left: 20px; flex-basis: initial; visibility: visible; scale: 1 1;">
            <ui:Label text="Royal Scout" name="Title" style="align-self: center; align-items: center; font-size: 24px;"/>
            <ui:Label text="Oh no! We are under attack!" name="Desc" style="align-self: stretch; align-items: stretch; justify-content: center; align-content: flex-start; font-size: 18px; -unity-text-align: upper-center; white-space: normal;"/>
        </ui:VisualElement>
        <ui:Button text="X" name="exit" style="position: absolute; top: 18px; left: 310px; height: 26px; width: 26px; font-size: 24px; background-color: rgb(255, 0, 0); color: rgb(255, 255, 255); visibility: hidden;"/>
    </ui:VisualElement>
</ui:UXML>
