<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="TowerButtons" style="flex-grow: 1; position: absolute; height: 544px; width: 396px; top: 170px; left: 22px; align-items: center; justify-content: space-evenly;">
        <ui:Button text="Tower1" name="t1" style="position: relative; top: auto; left: auto; height: 120px; width: 300px; font-size: 75px;"/>
        <ui:Button text="Tower2" name="t2" style="position: relative; top: auto; left: auto; height: 120px; width: 300px; font-size: 75px;"/>
        <ui:Button text="Tower3" name="t3" style="position: relative; top: auto; left: auto; height: 120px; width: 300px; font-size: 75px; text-overflow: ellipsis;"/>
    </ui:VisualElement>
    <ui:VisualElement name="MoneyHUD" style="aspect-ratio: auto; height: 143px; background-color: rgb(0, 111, 7); width: 868px; position: absolute; top: 25px; left: 25px;">
        <ui:VisualElement name="MoneyHUDMask" style="flex-grow: 1; position: absolute; width: 100%; height: 100%; overflow: hidden; transition-property: width; transition-duration: 0.5s; transition-timing-function: ease-out-elastic;">
            <ui:VisualElement name="MoneyHUDFill" style="flex-grow: 1; position: relative; width: 97.5%; height: 80%; background-color: rgb(116, 255, 0); margin-top: 10px; margin-right: 10px; margin-bottom: 10px; margin-left: 10px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; overflow: visible;"/>
        </ui:VisualElement>
        <ui:Label text="0 / - $" name="MoneyHUDLabel" style="top: auto; left: auto; font-size: 60px; -unity-text-align: middle-left; position: absolute; width: 100%; height: 100%; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 25px;"/>
    </ui:VisualElement>
    <ui:VisualElement name="WaveHUD" style="flex-grow: 1; position: absolute; height: 968px; width: 552px; top: 28px; left: 1356px; align-items: stretch; justify-content: flex-start; align-self: flex-start; align-content: flex-start;">
        <ui:Label text="Enemy Forces" style="font-size: 75px; white-space: nowrap; text-overflow: clip;"/>
        <ui:VisualElement name="WaveMeter" style="flex-grow: 1; position: absolute; height: 93px; width: 800px; top: 478px; left: 10px; justify-content: flex-start; align-items: stretch; align-self: flex-start; align-content: flex-start; flex-direction: column-reverse; flex-wrap: nowrap; background-color: rgba(86, 86, 86, 0.667); rotate: 270deg; transform-origin: center; border-top-width: 5px; border-right-width: 5px; border-bottom-width: 5px; border-left-width: 5px; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); border-top-left-radius: 30px; border-top-right-radius: 30px; border-bottom-right-radius: 30px; border-bottom-left-radius: 30px;">
            <ui:VisualElement name="Bar" style="flex-grow: 1; background-color: rgb(207, 157, 64); width: 25%; transition-property: width; transition-duration: 0.15s; transition-timing-function: ease-in-sine; background-size: 100% 100%; color: rgb(207, 157, 64); scale: 1 1; border-top-left-radius: 30px; border-top-right-radius: 30px; border-bottom-right-radius: 30px; border-bottom-left-radius: 30px;"/>
        </ui:VisualElement>
        <ui:VisualElement style="flex-grow: 1; position: absolute; height: 15px; width: 47px; top: 725px; left: 364px; background-color: rgb(51, 51, 51);"/>
        <ui:VisualElement style="flex-grow: 1; position: absolute; height: 15px; width: 47px; top: 525px; left: 364px; background-color: rgb(51, 51, 51);"/>
        <ui:VisualElement style="flex-grow: 1; position: absolute; height: 15px; width: 47px; top: 325px; left: 364px; background-color: rgb(51, 51, 51);"/>
        <ui:VisualElement style="flex-grow: 1; position: absolute; height: 15px; width: 47px; top: 150px; left: 368px; background-color: rgb(51, 51, 51);"/>
    </ui:VisualElement>
</ui:UXML>
